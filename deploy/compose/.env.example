# Compose settings (not app settings: those live in $ZIPNET_ROOT/env/*.env). Copy to deploy/compose/.env.

# Image tag = the git commit the images were built from. deploy/ops/release.sh sets it; rollback = set the old SHA.
ZIPNET_TAG=<git sha, e.g. output of: git rev-parse --short=12 HEAD>

# Host layout (deploy/bootstrap.sh creates it)
ZIPNET_ROOT=/srv/zipnet
# The zipnet user's uid/gid (`id -u zipnet`, `id -g zipnet`): every container runs as it, so it can read the
# 600-mode secrets and write its data dir, and nothing runs as root.
ZIPNET_UID=1000
ZIPNET_GID=1000

# Hostnames: app.<domain>, mini.<domain>, api.<domain>, postman.<domain>, courier1.<domain>, veridia.<domain>,
# archive.<domain>
ZIPNET_DOMAIN=zipcoin.org

# Which contracts/deployments/<file> under $ZIPNET_ROOT/deployments the services read (sepolia.json for the rehearsal)
DEPLOYMENT_FILE=mainnet.json

# Optional services: veridia, archive (comma-separated). Empty = postman, courier1, stats, web, edge, cloudflared.
COMPOSE_PROFILES=veridia,archive

# Pinned third-party images. Check the current release before the first deploy and pin it here:
#   https://github.com/cloudflare/cloudflared/releases   https://hub.docker.com/_/caddy
CLOUDFLARED_VERSION=2025.1.0
CADDY_IMAGE=caddy:2.8.4-alpine

# More couriers: see couriers.override.example.yml
# COMPOSE_FILE=docker-compose.yml:couriers.override.yml
