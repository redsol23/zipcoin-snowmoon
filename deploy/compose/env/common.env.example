# Shared by every service. Copy to $ZIPNET_ROOT/env/common.env (mode 600). Keys and phrases do NOT go here: they are
# Docker secrets under $ZIPNET_ROOT/secrets/. Set in docker-compose.yml, not here: DEPLOYMENT, PORT, DATA_DIR and the
# internal service URLs. No inline comments after values: keep comments on their own lines.

# The services' own node (never the public proxy). Couriers override it with a private-mempool endpoint.
RPC_URL=<own node RPC URL>
# Keep equal to the postman's epoch everywhere (stats, Emerald)
EPOCH_SEC=3600
