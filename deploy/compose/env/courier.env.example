# Courier (apps/courier). Copy to $ZIPNET_ROOT/env/courier1.env (courier2.env, ... for more), mode 600.
# Key: secrets/courierN_key; cover wallet phrase: secrets/courierN_cover_mnemonic (empty file = no cover traffic).

# PRIVATE MEMPOOL: relayed proofs are valid for whoever lands them first. Point each courier at a private-transaction
# RPC, never a public mempool (this overrides RPC_URL from common.env).
RPC_URL=<private-mempool RPC URL>
BOND_WEI=1000000000000000000000
# Optional separate EOA key for delivery receipts (registered at the first bond; default COURIER_KEY)
# RECEIPT_KEY=
ZC_PER_ETH_WAD=<market price, updated on a schedule>
MIN_FEE_WEI=<fee floor>
FEE_MARGIN_BPS=2000
EPOCH_MARGIN_SEC=120
# A held pool proof too late in its ASP epoch for a receipt goes out at once, unreceipted, unless the epoch ends within
# this many seconds (about a block): then it is refused, since even a send now may land on the new root
# ASP_TURN_GUARD_SEC=12
# Days a finished job (sent or failed) stays in jobs.json and on /jobs/:id; pruned hourly
# JOBS_RETENTION_DAYS=7
# Held receipted jobs go out at least this long before their deadline (+ SEND_SLOT_SEC per job queued ahead)
# DELIVER_MARGIN_SEC=300
# SEND_SLOT_SEC=3
COVER_PER_HOUR=<n>
COVER_DAILY_GAS_WEI=<daily cover-traffic gas budget>
FREE_RELAYS_PER_DAY=500
# Free-relay budget shape (defaults shown): reserve for payout recovery, per-kind share, per-client attempts/hour
# FREE_RESERVED_SHARE=0.2
# FREE_KIND_SHARE=0.5
# FREE_PER_CLIENT_PER_HOUR=60
# Behind the tunnel: take the client address from X-Forwarded-For
# TRUST_PROXY=1
BANDS_EVERY_MIN=360
BANDS_MIN_VALUE_MULT=20
