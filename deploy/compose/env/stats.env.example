# Stats API (apps/stats) at api.<domain>. Copy to $ZIPNET_ROOT/env/stats.env (mode 600). No key.
# HOST, PORT, POSTMAN_URL and TRUST_PROXY are set in docker-compose.yml.
CORS_ORIGINS=https://zipcoin.org,https://www.zipcoin.org
RATE_LIMIT_PER_MIN=60
# Private list of the project's own wallets (one per line) in $ZIPNET_ROOT/config/stats-exclude.txt; never served
EXCLUDE_FILE=/etc/zipnet/stats-exclude.txt
PROJECT_FUNDERS=<Veridia treasury address>
# Never set DEV_ORIGINS or ALLOW_PRIVATE_ENDPOINTS in production.
