# Veridia (apps/veridia), profile "veridia". Copy to $ZIPNET_ROOT/env/veridia.env (mode 600).
# Key: secrets/veridia_key (ZC + ETH). DeepSeek key: secrets/deepseek_api_key (shared with Emerald; empty = scripted).
VERIDIA_SEED=<seed>
VERIDIA_LLM=auto
VERIDIA_MODEL=deepseek-flash
ACTIONS_PER_HOUR=6
# 0.02 ETH/day cap; residents go chain-free once it is spent
VERIDIA_DAILY_GAS_WEI=20000000000000000
# ETH each resident wallet gets at bootstrap for gas (default 0.5; a testnet needs ~0.001)
# VERIDIA_RESIDENT_ETH=0.5
VERIDIA_CYCLE_MIN=360
VERIDIA_STORY_DELAY_MIN=20
VERIDIA_STORY_DELAY_MAX=120
MAX_HOLD_SEC=<n>
