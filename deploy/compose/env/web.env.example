# Web app (apps/web): wallet and Emerald. Copy to $ZIPNET_ROOT/env/web.env (mode 600).
# Secrets: secrets/deepseek_api_key, secrets/emerald_session_secret (32+ chars).
# Set in docker-compose.yml: DEPLOYMENT, COURIER_URL, POSTMAN_URL, VERIDIA_URL, PUBLIC_COURIER_URL.
# Never set DEV_FAUCET_KEY in production.

# Visible to every visitor: a rate-limited public proxy, never the services' own node
PUBLIC_RPC_URL=<rate-limited public RPC proxy>

# Mobile wallets over WalletConnect (docs/DEPLOY.md, "Mobile wallets"). Unset = the option is hidden and no Reown
# origin is in the CSP. Get the ID at https://dashboard.reown.com (new project), and in the project's Domain settings
# allow only https://zipcoin.org, https://www.zipcoin.org and https://app.zipcoin.org. Public, not a secret.
# WALLETCONNECT_PROJECT_ID=<Reown project ID>

# Emerald (docs/DEPLOY.md step 7)
EMERALD_MODEL=deepseek-flash
EMERALD_MIN_TIER=1
EMERALD_MIN_HOLD_WEI=100000000000000000000000
