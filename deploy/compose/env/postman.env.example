# Postman (apps/postman). Copy to $ZIPNET_ROOT/env/postman.env (mode 600). Key: secrets/postman_key.
# Decided launch values (docs/DEPLOY.md step 5).
VET_DELAY_SEC=1800
SANCTIONS_ORACLE=0x40C57923924B5c5c5455c48D93317139ADDaC8fb
# 1,000,000 ZC per deposit; 3,000,000 ZC per depositor per rolling 24h
MAX_DEPOSIT_WEI=1000000000000000000000000
MAX_DEPOSITOR_DAILY_WEI=3000000000000000000000000
# Optional: newline-separated addresses to reject, in $ZIPNET_ROOT/config/denylist.txt
# DENYLIST_FILE=/etc/zipnet/denylist.txt
