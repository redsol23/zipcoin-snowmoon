# zipnet mainnet environment: every deploy and service variable, with the owner's launch decisions filled in.
#
# Placeholders only. Copy what each process needs into its own env on its own server; never commit real values.
# <angle brackets> are yours to fill; everything else is the decided launch value. See docs/DEPLOY.md for the runbook
# and the decision table these values come from.
#
# The contracts go out with one command (docs/DEPLOY.md, "One command"), reading this file:
#
#   ./scripts/deploy-mainnet.sh fork --env-file deploy/mainnet.env.example     rehearsal on a mainnet fork; runs as is
#   ./scripts/deploy-mainnet.sh owners|dry|broadcast --env-file <your filled copy, outside git>
#
# Amounts are in wei (ZC has 18 decimals): 1 ZC = 1000000000000000000.

# ---------------------------------------------------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------------------------------------------------
# Services talk to the owner's own node. The web app gets a separate, rate-limited public proxy (PUBLIC_RPC_URL below).
RPC_URL=<own node, e.g. https://rpc.internal.<domain>>
ETHEREUM_MAINNET_RPC=<own node, for forge script and the fork test>
DEPLOYMENT=../../contracts/deployments/mainnet.json

# ---------------------------------------------------------------------------------------------------------------------
# Contracts: forge script script/Deploy.s.sol:Deploy (run from contracts/; see docs/DEPLOY.md step 3)
#
# On chain 1 every variable in this section is REQUIRED unless marked optional: the script refuses (reverts with a
# "mainnet: ..." message before broadcasting anything) instead of falling back to a default, a stand-in contract or
# the deployer. docs/DEPLOY.md step 3 lists each check and its message.
# ---------------------------------------------------------------------------------------------------------------------
PRIVATE_KEY=<throwaway deployer key: ETH for gas only>
# scripts/deploy-mainnet.sh sets DEPLOYMENT itself (mainnet, or mainnet-{fork,sim}-local for the rehearsals).
# Output name: writes contracts/deployments/mainnet.json. Chain 1: required, and not "local".
# (The DEPLOYMENT above is the path the services read; forge takes the name. Set this one on the forge command line.)
# DEPLOYMENT=mainnet

# Existing mainnet contracts. Chain 1: each must equal the value below and have code.
# ZC also must report totalSupply 1e27 and answer holderFeesEnabled(); no stand-in ZC is ever deployed on chain 1.
ZC_ADDRESS=0x2CA7B61B23b15e75aC7AB60Dd6f627895d64a46E
# 0xbow production verifiers and Entrypoint implementation (the implementation must answer proxiableUUID()).
WITHDRAWAL_VERIFIER=0x022891F938Ae7fDC8Ab9Ead0FBf50aBA8C897D6d
RAGEQUIT_VERIFIER=0xa45ACa8604a73D80C551fAad6355A5c3A5565eC6
ENTRYPOINT_IMPL=0x15e355024de1CDc74ADdea7EBDf98418Ba5B1a2c
# Optional escape hatch, leave unset: 1 lets the three above be unset (deployed fresh from the vendored sources) or
# differ from 0xbow's. Fresh copies verify the same proofs but are a new, unreviewed deployment, not the instances the
# fork test and the audit cover.
# ALLOW_FRESH_VERIFIERS=1
# Canonical Semaphore v4 (the same address on Ethereum mainnet and the other networks Semaphore lists).
# Source: https://docs.semaphore.pse.dev/deployed-contracts (Semaphore V4: Semaphore 0x8A1fd199516489B0Fb7153EB5f075cDAC83c693D,
# SemaphoreVerifier 0x4DeC9E3784EcC1eE002001BfE91deEf4A48931f8, PoseidonT3 0xB43122Ecb241DD50062641f089876679fd06599a).
# Chain 1: must be this address, and its verifier() must be that SemaphoreVerifier.
SEMAPHORE_ADDRESS=0x8A1fd199516489B0Fb7153EB5f075cDAC83c693D

# Owners (scripts/deploy-mainnet.sh owners, which runs contracts/script/Owners.s.sol): two canonical Safe v1.4.1
# proxies (no modules, no guard) and an OpenZeppelin TimelockController whose only proposer and executor is the owner
# Safe, with no admin. Owner decision: 1-of-1 Safes (one signer), the 48h timelock stays.
SAFE_OWNERS=<the Safe signer address (comma-separated if more)>
SAFE_THRESHOLD=1
OWNER_MIN_DELAY=172800

# Roles: paste what `deploy-mainnet.sh owners` prints. Chain 1: all four set, pairwise different, none the deployer.
# OWNER is the timelock; OWNER_SAFE (the Safe behind it) and TREASURY must be Safes (code, getThreshold() >=
# SAFE_MIN_THRESHOLD, getOwners() >= SAFE_MIN_OWNERS).
OWNER=<owner timelock, from the owners step>
OWNER_SAFE=<owner Safe, from the owners step>
TREASURY=<treasury Safe, from the owners step>
POSTMAN=<postman hot key address (roots only; rotate via OWNER)>
# The Safe policy the script enforces: 1-of-1 (owner decision). Deploy's defaults are 2 and 3, so set both.
SAFE_MIN_THRESHOLD=1
SAFE_MIN_OWNERS=1
# Typed confirmation that MAX_DEPOSIT_WEI and MAX_DEPOSITOR_DAILY_WEI are set in the postman env below.
# The caps live in the postman, not on chain, so the deploy script can only ask; on chain 1 it refuses without this.
POSTMAN_CAPS_ACK=MAX_DEPOSIT_WEI,MAX_DEPOSITOR_DAILY_WEI

# Treasury liquidity bands (owner decision: build it; docs/DEPLOY.md step 4b). ZC's v4 pool config: both or neither
# (one alone refuses everywhere). With both, ZipLiquidityBands is deployed with TREASURY as its Safe. Chain 1: they
# must be these addresses, the PositionManager's poolManager()/permit2() and ZC's market()/factory() must match, and
# the factory's poolKeyFor(ZC) must be ETH/ZC, fee 10000, tickSpacing 200, this hook, start tick 196600.
BANDS_POSITION_MANAGER=0xbD216513d74C8cf14cf4747E6AaA6420FF64ee9e
BANDS_HOOK=0xCb69D5aBe0589AF4c57b0dCCA292980D5E52C0c0
# The bands add ZC ABOVE the launch range only (owner decision 2026-09-29: nothing below it). Any ETH reaching the
# bands contract is passed on to the Safe, never put into liquidity.
# Immutable ZC day-cap ceiling (the Safe sets the caps below it). Chain 1 with bands: required.
BANDS_MAX_DAY_ZC=10000000000000000000000000
# Payout destinations (immutable). Accepted everywhere: "bands", "safe" (= TREASURY), or the address of either.
# Anything else refuses. "bands" without BANDS_POSITION_MANAGER / BANDS_HOOK refuses. Chain 1: both required.
# ZipPay's treasury share of the tax: the bands contract (decision 18).
TAX_TREASURY=bands
# The pool's harvested ETH: the Safe (launch default; decision 18 leaves "bands" open).
HARVEST_TREASURY=safe

# Economics (immutable once deployed). Chain 1: each one required (no silent defaults).
MIN_DEPOSIT=1000000000000000000
MAX_RELAY_BPS=500
TAX_BPS=100
BURN_SHARE_BPS=5000
COURIER_SHARE_BPS=3000
MIN_BURN=100000000000000000000
MERCHANT_MIN_STAKE=1000000000000000000000
COURIER_MIN_STAKE=1000000000000000000000
# Smallest ZipPay base that may join a merchant's payer group (sybil cost = the tax on it). Chain 1: at least 10,000 ZC
PAYER_GROUP_MIN_BASE=10000000000000000000000
# ---------------------------------------------------------------------------------------------------------------------
# Postman (apps/postman): run by the owner on their VPS
# ---------------------------------------------------------------------------------------------------------------------
POSTMAN_KEY=<postman hot key>
EPOCH_SEC=3600
VET_DELAY_SEC=1800
# Launch deposit caps: 1,000,000 ZC per deposit, 3,000,000 ZC per depositor per rolling 24h
MAX_DEPOSIT_WEI=1000000000000000000000000
MAX_DEPOSITOR_DAILY_WEI=3000000000000000000000000
SANCTIONS_ORACLE=0x40C57923924B5c5c5455c48D93317139ADDaC8fb
STATE_FILE=/var/lib/zipnet/postman.json
PORT=8710
# DENYLIST_FILE=/etc/zipnet/denylist.txt
# Optional: where updateRoot is broadcast (reads stay on RPC_URL). Unset = RPC_URL's public mempool, which is fine for
# the postman: only the POSTMAN role can call updateRoot and the root is public. /health answers 503 when not ok.
# SEND_RPC_URL=
# CONFIRM_TIMEOUT_SEC=300

# ---------------------------------------------------------------------------------------------------------------------
# Courier (apps/courier): open to anyone who stakes. One env per courier server.
# ---------------------------------------------------------------------------------------------------------------------
# PRIVATE MEMPOOL: reads go to RPC_URL (the courier's own node); signed transactions go only to SEND_RPC_URL, which
# must be a private relay, never a public mempool. Relayed Semaphore and spend proofs are valid for whoever lands them
# first, so a public mempool lets anyone copy and front-run them. Pick one (docs/DEPLOY.md §6 compares them), e.g.
# Flashbots Protect https://rpc.flashbots.net/fast, or MEV Blocker https://rpc.mevblocker.io/noreverts or /fullprivacy.
# RPC_URL=<own node>
SEND_RPC_URL=<private relay RPC>
# A transaction not landed this long after its last send is re-simulated and resent at the same nonce with higher fees;
# one that no longer simulates is given up (its nonce filled by a self-transfer) only after ABANDON_AFTER_SEC.
# RESEND_AFTER_SEC=120
# ABANDON_AFTER_SEC=600
COURIER_KEY=<courier key: bonded ZC + ETH for gas>
POSTMAN_URL=https://postman.<domain>
PUBLIC_URL=https://courier1.<domain>
BOND_WEI=1000000000000000000000
# Fees: gas x gas price x (1 + FEE_MARGIN_BPS/10000) in ZC, at the median ZC price of the courier's own samples of the
# ZC/ETH pool (via ZipLiquidityBands.slot0) over FEE_TWAP_SEC, never below MIN_FEE_WEI. The courier won't start on
# mainnet without MIN_FEE_WEI. ZC_PER_ETH_WAD, if set, replaces the pool price with a fixed one (keep it current).
MIN_FEE_WEI=<fee floor in ZC wei>
FEE_MARGIN_BPS=2000
# ZC_PER_ETH_WAD=
# FEE_SAMPLE_SEC=60
# FEE_TWAP_SEC=1800
# FEE_MIN_SAMPLES=5
# A quote is honoured for QUOTE_VALID_SEC (a fresh one at most every QUOTE_REFRESH_SEC)
# QUOTE_VALID_SEC=600
# QUOTE_REFRESH_SEC=60
EPOCH_MARGIN_SEC=120
COVER_PER_HOUR=<n>
COVER_DAILY_GAS_WEI=<daily cover-traffic gas budget>
COVER_MNEMONIC=<cover wallet phrase>
FREE_RELAYS_PER_DAY=500
# Liquidity bands job: check every 6h; deposit only when the value is at least 20x the deposit's gas
BANDS_EVERY_MIN=360
BANDS_MIN_VALUE_MULT=20
DATA_DIR=/var/lib/zipnet/courier
# PORT=8720

# ---------------------------------------------------------------------------------------------------------------------
# Web app (apps/web)
# ---------------------------------------------------------------------------------------------------------------------
# Visible to every visitor: the rate-limited public proxy, never the services' own node. Required: /api/config never
# falls back to RPC_URL, and answers 503 without it.
PUBLIC_RPC_URL=<rate-limited public RPC proxy>
PUBLIC_COURIER_URL=https://courier1.<domain>
VERIDIA_URL=https://veridia.<domain>
# Never set DEV_FAUCET_KEY in production.
# Security headers: docs/DEPLOY.md, "Web security headers".
# Courier origins the browser may connect to. Unset = any https: origin (couriers come from the chain); set a list to
# pin it (a courier outside it is skipped by the wallet)
# COURIER_ORIGINS=https://courier1.<domain>,https://courier2.<domain>
# STATS_ORIGIN=https://api.zipcoin.org
# POSTMAN_URL=https://postman.<domain>
# Mobile wallets over WalletConnect (docs/DEPLOY.md, "Mobile wallets"). Unset = hidden, and no Reown origin in the CSP.
# Create a project at https://dashboard.reown.com, then in its Domain settings allow only the wallet's origins
# (https://zipcoin.org, https://www.zipcoin.org, https://app.zipcoin.org); an empty allowlist lets anyone use the ID.
# Public, not a secret. NEXT_PUBLIC_REOWN_PROJECT_ID is accepted as an alias.
# WALLETCONNECT_PROJECT_ID=<Reown project ID>

# Emerald (the wallet's assistant): DeepSeek, gated by a tier-1+ badge proof or 100k ZC held in a signed wallet.
DEEPSEEK_API_KEY=<DeepSeek API key>
EMERALD_MIN_TIER=1
EMERALD_MIN_HOLD_WEI=100000000000000000000000
# Daily DeepSeek budget (USD, per UTC day). Past it Emerald rests until tomorrow.
EMERALD_DAILY_USD_CAP=<daily model budget in USD, e.g. 10>
EMERALD_BUDGET_FILE=/var/lib/zipnet/emerald-budget.json
# EMERALD_DAILY_TOKEN_CAP=
# EMERALD_SESSION_PER_MIN=10
# EMERALD_SESSION_PER_DAY=200

# ---------------------------------------------------------------------------------------------------------------------
# Stats API (apps/stats) at https://api.zipcoin.org: read-only, no key. Behind a TLS proxy on the same host.
# What it may show is apps/stats/public-contracts.json ("show": true); everything else stays off until its launch.
# ---------------------------------------------------------------------------------------------------------------------
# RPC_URL=<services' own node>
# DEPLOYMENT=contracts/deployments/mainnet.json
# PORT=8750
# HOST=127.0.0.1
# POSTMAN_URL=http://127.0.0.1:8710   # the postman on the same host
# EPOCH_SEC=3600                       # as the postman
TRUST_PROXY=1
CORS_ORIGINS=https://zipcoin.org,https://www.zipcoin.org
RATE_LIMIT_PER_MIN=60
# The project's own wallets the chain can't tell apart (Veridia residents and treasury, couriers' cover wallets);
# private, one address per line, never served
EXCLUDE_FILE=/etc/zipnet/stats-exclude.txt
PROJECT_FUNDERS=<Veridia treasury address>
# Never set DEV_ORIGINS or ALLOW_PRIVATE_ENDPOINTS in production.

# ---------------------------------------------------------------------------------------------------------------------
# Veridia (apps/veridia): a small action budget with a daily gas cap; minds on DeepSeek (DEEPSEEK_API_KEY above)
# ---------------------------------------------------------------------------------------------------------------------
TREASURY_KEY=<Veridia key: ZC + ETH for the residents' actions>
COURIER_URL=https://courier1.<domain>
VERIDIA_SEED=<seed>
VERIDIA_LLM=auto                 # auto = DeepSeek when DEEPSEEK_API_KEY is set, scripted otherwise
DEEPSEEK_API_KEY=<deepseek key>  # same key as Emerald, or a separate one to track spend
# SEND_RPC_URL=                    # optional: where residents' own transactions are broadcast (reads stay on RPC_URL)
VERIDIA_MODEL=deepseek-flash
ACTIONS_PER_HOUR=6               # decided: small budget
VERIDIA_DAILY_GAS_WEI=20000000000000000   # 0.02 ETH/day cap; residents go chain-free once spent
VERIDIA_CYCLE_MIN=360
VERIDIA_STORY_DELAY_MIN=20              # the public story is published 20-120 min late, coarsened, out of chain order
VERIDIA_STORY_DELAY_MAX=120
MAX_HOLD_SEC=<n>
# DATA_DIR=/var/lib/zipnet/veridia
