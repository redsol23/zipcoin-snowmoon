# zipnet Sepolia rehearsal environment (chain id 11155111).
#
# Keep the filled copy outside git, readable only by you:
#
#   cp deploy/sepolia.env.example ~/zipnet-sepolia.env && chmod 600 ~/zipnet-sepolia.env    # then fill <brackets>
#   ./scripts/deploy-sepolia.sh --env-file ~/zipnet-sepolia.env                 simulation only (the default)
#   ./scripts/deploy-sepolia.sh --env-file ~/zipnet-sepolia.env --broadcast     the owner, by hand, after the simulation
#
# Without --env-file the script reads the variables from the environment (and falls back to the defaults below).
#
# Why this differs from mainnet.env.example:
# - ZC is a mainnet-only token. There is no ZC on Sepolia, so ZC_ADDRESS stays UNSET and Deploy.s.sol deploys its
#   stand-in `LocalZC` ("zipcoin"/"ZC", 18 decimals, 1,000,000,000 minted to the deployer). It is a plain ERC20 with no
#   holder-reward or transfer hooks, so the rehearsal does not exercise ZC's own behaviour: that is what the mainnet fork
#   test (docs/DEPLOY.md step 1) is for. It has no value and must never be described as ZC.
# - The 0xbow verifiers and Entrypoint implementation are left unset too, so fresh copies are deployed from the same
#   sources (contracts/lib/privacy-pools-core). Mainnet uses 0xbow's production deployments.
# - Semaphore: the canonical Semaphore v4 deployment exists on Sepolia at the same address as mainnet.
#   Source: https://docs.semaphore.pse.dev/deployed-contracts (Semaphore V4, Sepolia: Semaphore
#   0x8A1fd199516489B0Fb7153EB5f075cDAC83c693D, SemaphoreVerifier 0x4DeC9E3784EcC1eE002001BfE91deEf4A48931f8).
#   deploy-sepolia.sh checks `cast code` and `verifier()` on-chain before it runs anything.
# - ZipLiquidityBands is not deployed (BANDS_* unset): it needs ZC's Uniswap v4 pool, which exists only on mainnet.

# RPC. A public endpoint is fine for the simulation; use your own key-restricted endpoint to broadcast.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Deployer: a throwaway key holding Sepolia ETH only (about 0.3 ETH covers the whole stack at a few gwei).
# Unset for a simulation: deploy-sepolia.sh then simulates from a random throwaway address and never broadcasts.
# PRIVATE_KEY=<throwaway Sepolia deployer key>

# Output name: contracts/deployments/<DEPLOYMENT>.json after a broadcast.
# Simulations write <DEPLOYMENT>-sim-local.json instead (gitignored), so a dry run never looks like a deployment.
DEPLOYMENT=sepolia

# Test token: leave unset (see above). deploy-sepolia.sh refuses the mainnet ZC address here.
# ZC_ADDRESS=

# Canonical Semaphore v4 on Sepolia (source above)
SEMAPHORE_ADDRESS=0x8A1fd199516489B0Fb7153EB5f075cDAC83c693D

# Roles. Unset = the deployer (fine for a rehearsal). To rehearse the mainnet hand-over, create them as on mainnet:
#   ./scripts/deploy-sepolia.sh --env-file ~/zipnet-sepolia.env --owners [--broadcast]
# runs contracts/script/Owners.s.sol: two canonical Safe v1.4.1 proxies (the same singleton and factory addresses as
# mainnet) and a TimelockController run by the owner Safe. 1-of-1 Safes, as decided for mainnet. Then paste the
# OWNER / OWNER_SAFE / TREASURY it prints below. (Off chain 1 Deploy does not check the Safes; mainnet does.)
# SAFE_OWNERS=<your signer address>
# SAFE_THRESHOLD=1
# OWNER_MIN_DELAY=172800
# OWNER=<timelock, from --owners>
# OWNER_SAFE=<owner Safe, from --owners>
# TREASURY=<treasury Safe, from --owners>
# POSTMAN=<postman address>

# Economics: the decided mainnet values, so the rehearsal matches
TAX_BPS=100
BURN_SHARE_BPS=5000
COURIER_SHARE_BPS=3000
MIN_BURN=100000000000000000000
MERCHANT_MIN_STAKE=1000000000000000000000
COURIER_MIN_STAKE=1000000000000000000000
# Smallest ZipPay base that may join a merchant's payer group (sybil cost = the tax on it)
PAYER_GROUP_MIN_BASE=1000000000000000000000

# Optional: Etherscan verification on broadcast
# ETHERSCAN_API_KEY=<key>

# ---------------------------------------------------------------------------------------------------------------------
# Services against the Sepolia deployment (deploy/compose, with COMPOSE_PROFILES as usual): set these in the
# per-service env files under /etc/zipnet/ instead of the mainnet values.
# ---------------------------------------------------------------------------------------------------------------------
# RPC_URL=<Sepolia RPC>
# DEPLOYMENT_FILE=sepolia.json       # the file under /srv/zipnet/deployments/ the services read
# EPOCH_SEC=600                      # short epochs make the rehearsal quicker to watch
# VET_DELAY_SEC=60
